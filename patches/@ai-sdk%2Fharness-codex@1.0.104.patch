diff --git a/node_modules/@ai-sdk/harness-codex/src/bridge/restricted.ts b/src/bridge/restricted.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2966f048abb46175033ab505f51ba57511dd5592
--- /dev/null
+++ b/src/bridge/restricted.ts
@@ -0,0 +1,329 @@
+import { chmod, mkdir } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { randomBytes } from 'node:crypto';
+import type { StartMessage } from '../codex-bridge-protocol';
+
+/**
+ * Linux `sockaddr_un.sun_path` is 108 bytes including the trailing NUL.
+ * Fail closed rather than falling back to TCP.
+ */
+export const UNIX_SOCKET_MAX_BYTES = 107;
+
+/** Proven 0.153.4 permissions table keys from the eval profile shape. */
+export const RESTRICTED_PERMISSIONS_PROFILE = 'restricted';
+
+const RESTRICTED_INHERITED_ENV_NAMES = [
+  'PATH',
+  'SystemRoot',
+  'WINDIR',
+  'COMSPEC',
+  'PATHEXT',
+  'LANG',
+  'LC_ALL',
+  'LC_CTYPE',
+  'TERM',
+  'COLORTERM',
+  'NO_COLOR',
+  'TMPDIR',
+  'TMP',
+  'TEMP',
+  'CI',
+] as const;
+
+const API_KEY_ENV_NAMES = [
+  'OPENAI_API_KEY',
+  'CODEX_API_KEY',
+  'AI_GATEWAY_API_KEY',
+  'AI_GATEWAY_BASE_URL',
+] as const;
+
+export type CodexRestrictedStart = {
+  readonly codexHome: string;
+  readonly readablePaths: readonly string[];
+  readonly nativeAuth: boolean;
+};
+
+/**
+ * ignore-user-config skips `$CODEX_HOME/config.toml` only; auth still uses
+ * CODEX_HOME. ignore-rules skips execpolicy `.rules`. ephemeral skips session
+ * transcript persistence. Native 0.153.4 still has CODEX_HOME scanners for
+ * skills/plugins/memories/hooks that have no adapter-owned exclusion flags.
+ * Full personal-state exclusion requires the host filtered store view, not
+ * extra guessed CLI flags.
+ */
+export const RESTRICTED_PERSONAL_STATE_GAP =
+  'ignoreUserConfig+ignoreRules+ephemeral do not exclude skills/plugins/memories/hooks under CODEX_HOME; host must present a filtered store view';
+
+export function parseRestrictedStart(
+  start: StartMessage,
+): CodexRestrictedStart | undefined {
+  if (!('restricted' in start) || start.restricted == null) return undefined;
+  const restricted = start.restricted;
+  if (typeof restricted !== 'object' || Array.isArray(restricted)) {
+    throw new Error('start.restricted must be an object');
+  }
+  if (!('codexHome' in restricted) || !('readablePaths' in restricted) || !('nativeAuth' in restricted)) {
+    throw new Error('start.restricted requires codexHome, readablePaths, and nativeAuth');
+  }
+  const { codexHome, readablePaths, nativeAuth } = restricted;
+  if (typeof codexHome !== 'string' || codexHome.length === 0) {
+    throw new Error('start.restricted.codexHome must be a non-empty string');
+  }
+  if (!Array.isArray(readablePaths)) {
+    throw new Error(
+      'start.restricted.readablePaths must be an array of strings',
+    );
+  }
+  const paths: string[] = [];
+  for (const path of readablePaths) {
+    if (typeof path !== 'string') {
+      throw new Error(
+        'start.restricted.readablePaths must be an array of strings',
+      );
+    }
+    paths.push(path);
+  }
+  if (typeof nativeAuth !== 'boolean') {
+    throw new Error('start.restricted.nativeAuth must be a boolean');
+  }
+  return {
+    codexHome,
+    readablePaths: paths,
+    nativeAuth,
+  };
+}
+
+export function assertRestrictedCallbacksUnsupported(
+  start: StartMessage,
+): void {
+  if ('permissionMode' in start) {
+    const permissionMode = start.permissionMode;
+    if (permissionMode != null && permissionMode !== 'allow-all') {
+      throw new Error(
+        'Codex exec does not support permissionMode callbacks; native sandbox enforces policy',
+      );
+    }
+  }
+  if (
+    'builtinToolFiltering' in start &&
+    start.builtinToolFiltering != null
+  ) {
+    throw new Error(
+      'Codex exec does not support builtin tool filtering callbacks',
+    );
+  }
+}
+
+export function assertRestrictedNativeAuth(
+  restricted: CodexRestrictedStart,
+  start: StartMessage,
+  procEnv: NodeJS.ProcessEnv,
+): void {
+  if (!restricted.nativeAuth) return;
+  if (
+    typeof start.resumeThreadId === 'string' &&
+    start.resumeThreadId.length > 0
+  ) {
+    throw new Error(
+      'native Codex restricted mode does not support resume or continue',
+    );
+  }
+  if (start.headers != null) {
+    throw new Error(
+      'native Codex restricted mode rejects API-key header injection',
+    );
+  }
+  const config = start.codexConfig;
+  if (config) {
+    if (
+      config.preferred_auth_method === 'apikey' ||
+      config.model_provider != null ||
+      config.model_providers != null
+    ) {
+      throw new Error(
+        'native Codex restricted mode rejects API-key provider injection',
+      );
+    }
+  }
+  if (procEnv.AI_GATEWAY_API_KEY || procEnv.AI_GATEWAY_BASE_URL) {
+    throw new Error(
+      'native Codex restricted mode rejects AI Gateway API-key discovery',
+    );
+  }
+}
+
+export async function allocatePrivateUnixRelaySocket(): Promise<{
+  socketPath: string;
+  socketDir: string;
+}> {
+  const socketDir = join(tmpdir(), `hcx${randomBytes(4).toString('hex')}`);
+  const socketPath = join(socketDir, 's');
+  if (Buffer.byteLength(socketPath) > UNIX_SOCKET_MAX_BYTES) {
+    throw new Error(
+      `restricted unix socket path exceeds ${UNIX_SOCKET_MAX_BYTES} bytes`,
+    );
+  }
+  await mkdir(socketDir, { recursive: false, mode: 0o700 });
+  await chmod(socketDir, 0o700);
+  return { socketPath, socketDir };
+}
+
+export function buildRestrictedFilesystemEntries({
+  codexHome,
+  readablePaths,
+  extraReadRoots,
+}: {
+  codexHome: string;
+  readablePaths: readonly string[];
+  extraReadRoots: readonly string[];
+}): Array<readonly [string, 'read' | 'deny']> {
+  const entries: Array<readonly [string, 'read' | 'deny']> = [
+    [':minimal', 'read'],
+  ];
+  const seen = new Set<string>([':minimal', codexHome]);
+  for (const root of [...extraReadRoots, ...readablePaths]) {
+    if (!root || seen.has(root) || root === codexHome) continue;
+    seen.add(root);
+    entries.push([root, 'read']);
+  }
+  entries.push([codexHome, 'deny']);
+  return entries;
+}
+
+const RESTRICTED_CALLER_CODEX_CONFIG_VALUES = {
+  model_reasoning_summary: ['auto', 'concise', 'detailed', 'none'],
+  model_verbosity: ['low', 'medium', 'high'],
+} as const;
+
+export type RestrictedCallerCodexConfigKey =
+  keyof typeof RESTRICTED_CALLER_CODEX_CONFIG_VALUES;
+
+function isRestrictedCallerCodexConfigKey(
+  key: string,
+): key is RestrictedCallerCodexConfigKey {
+  return Object.hasOwn(RESTRICTED_CALLER_CODEX_CONFIG_VALUES, key);
+}
+
+/**
+ * Restricted caller config is an exact allowlist of reasoning/output keys.
+ * Dotted, quoted, MCP, provider, auth, hook, plugin, feature, and sandbox
+ * namespaces are rejected rather than copied or denylisted.
+ */
+export function assertRestrictedCallerCodexConfig(
+  codexConfig: Record<string, unknown> | undefined,
+): void {
+  if (codexConfig == null) return;
+  for (const [key, value] of Object.entries(codexConfig)) {
+    if (!isRestrictedCallerCodexConfigKey(key)) {
+      throw new Error(
+        'restricted Codex mode rejects unapproved configuration keys',
+      );
+    }
+    const allowed: readonly string[] = RESTRICTED_CALLER_CODEX_CONFIG_VALUES[key];
+    if (typeof value !== 'string' || !allowed.includes(value)) {
+      throw new Error(
+        'restricted Codex mode rejects unapproved configuration values',
+      );
+    }
+  }
+}
+
+export function pickRestrictedCallerCodexConfig(
+  codexConfig: Record<string, unknown> | undefined,
+): Record<string, unknown> {
+  assertRestrictedCallerCodexConfig(codexConfig);
+  if (codexConfig == null) return {};
+  const next: Record<string, unknown> = {};
+  for (const key of Object.keys(RESTRICTED_CALLER_CODEX_CONFIG_VALUES)) {
+    if (!Object.hasOwn(codexConfig, key)) continue;
+    next[key] = codexConfig[key];
+  }
+  return next;
+}
+
+export function buildRestrictedCodexConfig({
+  baseConfig,
+  restricted,
+  extraReadRoots,
+}: {
+  baseConfig: Record<string, unknown>;
+  restricted: CodexRestrictedStart;
+  extraReadRoots: readonly string[];
+}): { config: Record<string, unknown>; configOverrides: string[] } {
+  const config = pickRestrictedCallerCodexConfig(baseConfig);
+  config.approval_policy = 'never';
+  config.web_search = 'disabled';
+  config.default_permissions = RESTRICTED_PERMISSIONS_PROFILE;
+  config.features = { apps: false };
+  config.model_reasoning_summary = 'detailed';
+
+  const filesystem = buildRestrictedFilesystemEntries({
+    codexHome: restricted.codexHome,
+    readablePaths: restricted.readablePaths,
+    extraReadRoots,
+  });
+  const filesystemTable = `{${filesystem
+    .map(([key, mode]) => `${JSON.stringify(key)} = ${JSON.stringify(mode)}`)
+    .join(', ')}}`;
+  const profile = RESTRICTED_PERMISSIONS_PROFILE;
+  const configOverrides = [
+    `permissions.${profile}.filesystem=${filesystemTable}`,
+    `permissions.${profile}.network={enabled = false}`,
+    `shell_environment_policy.include_only=${JSON.stringify([
+      ...RESTRICTED_INHERITED_ENV_NAMES,
+    ])}`,
+    `shell_environment_policy.exclude=${JSON.stringify([
+      'OPENAI_API_KEY',
+      'CODEX_API_KEY',
+      'CODEX_HOME',
+    ])}`,
+  ];
+  return { config, configOverrides };
+}
+
+export function buildRestrictedProcessEnv({
+  procEnv,
+  restricted,
+  home,
+}: {
+  procEnv: NodeJS.ProcessEnv;
+  restricted: CodexRestrictedStart;
+  home: string;
+}): Record<string, string> {
+  const env: Record<string, string> = {};
+  for (const name of RESTRICTED_INHERITED_ENV_NAMES) {
+    const value = procEnv[name];
+    if (typeof value === 'string' && value.length > 0) {
+      env[name] = value;
+    }
+  }
+  env.CODEX_HOME = restricted.codexHome;
+  env.HOME = home;
+  if (!restricted.nativeAuth) {
+    const apiKey = procEnv.CODEX_API_KEY ?? procEnv.OPENAI_API_KEY;
+    if (typeof apiKey === 'string' && apiKey.length > 0) {
+      env.CODEX_API_KEY = apiKey;
+    }
+  } else {
+    for (const name of API_KEY_ENV_NAMES) {
+      delete env[name];
+    }
+  }
+  return env;
+}
+
+export function applyRestrictedThreadOptions<
+  T extends {
+    sandboxMode?: string;
+    approvalPolicy?: string;
+    webSearchMode?: string;
+    networkAccessEnabled?: boolean;
+  },
+>(threadOptions: T): T {
+  delete threadOptions.sandboxMode;
+  delete threadOptions.networkAccessEnabled;
+  threadOptions.approvalPolicy = 'never';
+  threadOptions.webSearchMode = 'disabled';
+  return threadOptions;
+}
