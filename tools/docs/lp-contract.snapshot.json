    "getLpPositions": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "protocol": {
          "type": "string",
          "enum": ["uniswap-v3", "uniswap-v4"]
        },
        "tokenIds": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,77})$"
          }
        },
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "includeZeroLiquidity": {
          "default": true,
          "type": "boolean"
        },
        "cursor": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "getSolanaLpPositions": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "cursor": {
          "description": "Continuation cursor from a previous call's coverage.continuation.cursor. Enumeration is re-run and verification resumes at the cursor; holdings created between calls can shift the window.",
          "type": "string",
          "maxLength": 64
        },
        "knownPositions": {
          "description": "Verify only these named holdings instead of scanning the wallet. The result then makes no wallet-wide completeness claim.",
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mint": {
                "type": "string",
                "minLength": 32,
                "maxLength": 44,
                "description": "LP mint (CPMM) or position NFT mint (CLMM)."
              },
              "tokenAccountAddress": {
                "description": "Wallet token account holding the mint, when already known.",
                "type": "string",
                "minLength": 32,
                "maxLength": 44
              }
            },
            "required": ["mint"]
          }
        },
        "analytics": {
          "description": "Spot analytics surface only, where it defaults to true. False returns identity rows only, with economics marked not-requested. Ignored elsewhere, where economics never run.",
          "type": "boolean"
        },
        "valueInUsd": {
          "description": "Spot analytics surface only. Additively projects already-published raw amounts to USD using shared source-bound marks. Raw amounts are unaffected; mints without a mark stay explicitly unmarked.",
          "type": "boolean"
        }
      }
    },
    "quoteLpOperation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["open", "increase", "decrease", "collect", "close", "recenter"]
        },
        "intentId": {
          "description": "Pass an earlier quote's intentId to re-quote that intent.",
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "pool": {
          "description": "Required for open.",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "protocol": {
                  "type": "string",
                  "const": "uniswap-v3"
                },
                "chainId": {
                  "type": "number",
                  "const": 4663
                },
                "poolAddress": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{40}$"
                },
                "token0": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{40}$"
                },
                "token1": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{40}$"
                },
                "fee": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "tickSpacing": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32767
                }
              },
              "required": [
                "protocol",
                "chainId",
                "poolAddress",
                "token0",
                "token1",
                "fee",
                "tickSpacing"
              ]
            },
            {
              "type": "object",
              "properties": {
                "protocol": {
                  "type": "string",
                  "const": "uniswap-v4"
                },
                "chainId": {
                  "type": "number",
                  "const": 4663
                },
                "poolId": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{64}$"
                },
                "poolKey": {
                  "type": "object",
                  "properties": {
                    "currency0": {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{40}$"
                    },
                    "currency1": {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{40}$"
                    },
                    "fee": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 16777215
                    },
                    "tickSpacing": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 32767
                    },
                    "hooks": {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{40}$"
                    }
                  },
                  "required": ["currency0", "currency1", "fee", "tickSpacing", "hooks"]
                }
              },
              "required": ["protocol", "chainId", "poolId", "poolKey"]
            }
          ]
        },
        "position": {
          "description": "Required for every operation except open.",
          "type": "object",
          "properties": {
            "chainId": {
              "type": "number",
              "const": 4663
            },
            "protocol": {
              "type": "string",
              "enum": ["uniswap-v3", "uniswap-v4"]
            },
            "positionManager": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "tokenId": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,77})$"
            }
          },
          "required": ["chainId", "protocol", "positionManager", "tokenId"]
        },
        "tickLower": {
          "description": "Required for open and recenter.",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "tickUpper": {
          "description": "Required for open and recenter.",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "amount0Desired": {
          "description": "Required for open and increase.",
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        },
        "amount1Desired": {
          "description": "Required for open and increase.",
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        },
        "liquidity": {
          "description": "Required for decrease.",
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        },
        "slippageBps": {
          "default": 50,
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "deadlineSeconds": {
          "default": 300,
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "funding": {
          "type": "object",
          "properties": {
            "account": {
              "type": "string",
              "description": "Delegated wallet these ceilings authorize. Must match the quoting wallet."
            },
            "chainId": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Chain these ceilings authorize. Must match the pool."
            },
            "fee": {
              "minItems": 1,
              "maxItems": 8,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "const": "sponsored"
                      }
                    },
                    "required": ["mode"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "const": "fee-token"
                      },
                      "asset": {
                        "type": "string",
                        "description": "native, or the fee-token address."
                      },
                      "maxWeiAmount": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,77})$"
                      }
                    },
                    "required": ["mode", "asset", "maxWeiAmount"],
                    "additionalProperties": false
                  }
                ]
              },
              "description": "Ordered authorized fee alternatives. No implicit paid fallback."
            },
            "assetCeilings": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "asset": {
                    "type": "string"
                  },
                  "maxWeiAmount": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,77})$"
                  }
                },
                "required": ["asset", "maxWeiAmount"],
                "additionalProperties": false
              }
            },
            "reserves": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "asset": {
                    "type": "string"
                  },
                  "minRetainedWeiAmount": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,77})$"
                  }
                },
                "required": ["asset", "minRetainedWeiAmount"],
                "additionalProperties": false
              }
            }
          },
          "required": ["account", "chainId", "fee", "assetCeilings", "reserves"],
          "description": "Required caller authorization for fees, debit ceilings, and retained balances. A quote without these terms is not stored."
        }
      },
      "required": ["kind", "funding"]
    },
