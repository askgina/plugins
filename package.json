{
  "name": "askgina-plugins",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "plugins/ask-gina",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "evals:dev": "bun run --cwd apps/evals dev",
    "evals:build": "bun run --cwd apps/evals build",
    "evals:check-public": "bun tools/check-eval-public-artifacts.ts",
    "evals:check-grading": "bun tools/regrade-eval-search.ts --check && bun tools/regrade-eval-perps.ts --check",
    "evals:typecheck": "bun run --cwd apps/evals typecheck",
    "storybook": "bun run --cwd apps/evals storybook",
    "build-storybook": "bun run --cwd apps/evals build-storybook",
    "fmt:check": "vp fmt --check .",
    "lint": "bun run build && vp lint --deny-warnings .",
    "check": "vp run quality",
    "build": "vp run build-packages",
    "test": "vp run tests",
    "artifacts": "vp run build-artifacts",
    "verify:artifacts": "vp run verify-artifacts",
    "check:public-boundary": "vp run public-boundary",
    "check:target-conformance": "vp run target-conformance",
    "check:typescript-imports": "bun tools/check-typescript-imports.ts",
    "manifests:generate": "bun tools/plugin-manifests.ts",
    "manifests:check": "bun tools/plugin-manifests.ts --check",
    "skills:index": "bun tools/skill-index.ts",
    "skills:index:check": "bun tools/skill-index.ts --check",
    "verify:packages": "bun tools/verify-artifacts.ts --packages",
    "verify:targets": "bun tools/verify-artifacts.ts --targets",
    "smoke:install": "bun tools/verify-artifacts.ts --packages",
    "audit": "bun audit",
    "eval:replay": "bun run build && bun packages/evals/dist/bin/replay.js",
    "eval:export-public": "bun run build && bun packages/evals/dist/bin/export-public-results.js",
    "eval:responses": "bun run build && bun packages/evals/dist/bin/live.js --runner responses",
    "eval:codex": "bun run build && bun packages/evals/dist/bin/live.js --runner codex",
    "eval:openrouter": "bun run build && bun packages/evals/dist/bin/live.js --runner openrouter",
    "eval:claude": "bun run build && bun packages/evals/dist/bin/live.js --runner claude",
    "eval:omp": "bun run build && bun packages/evals/dist/bin/live.js --runner omp",
    "check:marketplace:codex": "bun run build && bun packages/evals/dist/bin/check-codex-marketplace.js",
    "effect-tsgo:patch": "bun scripts/effect-tsgo-patch-if-needed.ts",
    "prepare": "bun run effect-tsgo:patch",
    "typecheck": "bun run build && node_modules/.bin/tsc --noEmit -p tsconfig.json",
    "effect-tsgo:diagnostics": "node_modules/.bin/effect-tsgo diagnostics --project tsconfig.json --format json",
    "docs:check": "node tools/docs/check.mjs",
    "docs:catalog": "node tools/docs/skills-catalog.mjs",
    "docs:catalog:check": "node tools/docs/skills-catalog.mjs --check",
    "docs:test": "node --test tools/docs/*.test.mjs tools/docs/sweep/compare.test.mjs"
  },
  "devDependencies": {
    "@askgina/contracts": "workspace:*",
    "@effect/language-service": "0.87.2",
    "@effect/platform-bun": "4.0.0-rc.111",
    "@effect/tsgo": "0.55.0",
    "@effect/vitest": "4.0.0-rc.111",
    "@shadcn/lint": "0.1.0",
    "@types/bun": "1.4.0",
    "@types/node": "25.6.0",
    "effect": "4.0.0-rc.111",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5",
    "yaml": "2.8.3"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.111",
    "esbuild": "0.28.1",
    "ip-address": "10.7.4",
    "oxlint": "1.88.0",
    "qs": "6.16.0",
    "tinypool": "2.1.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "engines": {
    "bun": "1.4.x"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "@storybook/react@10.6.3": "patches/@storybook%2Freact@10.6.3.patch",
    "react-docgen-typescript@2.4.0": "patches/react-docgen-typescript@2.4.0.patch"
  }
}
