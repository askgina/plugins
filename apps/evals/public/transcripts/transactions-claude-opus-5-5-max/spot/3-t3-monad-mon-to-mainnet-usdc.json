":4,"content":[{"type":"toolResult","text":"[{\"id\":\"monad-swap-mon-usdc\",\"kind\":\"swap\",\"from\":{\"account\":\"mon1\",\"asset\":\"MON\"},\"to\":{\"account\":\"mon1\",\"asset\":\"USDC\"},\"delay_s\":1},{\"id\":\"monad-bridge-usdc-mainnet\",\"kind\":\"bridge\",\"from\":{\"account\":\"mon1\",\"asset\":\"USDC\"},\"to\":{\"account\":\"eth1\",\"asset\":\"USDC\"},\"delay_s\":60}]","toolCallId":"toolu_01227Q54tasadA72CqtnqSUJ","toolName":"mcp__ai_sdk_harness_tools_list_legs","isError":false}]},{"role":"tool","sequence":5,"content":[{"type":"toolResult","text":"{\"max_total_cost_usd_micros\":3000000,\"max_slippage_bps\":50,\"deadline_s\":1800,\"quote_ttl_s\":300}","toolCallId":"toolu_01JsqXpDSgGDZv97NbWNVb9Y","toolName":"mcp__ai_sdk_harness_tools_get_policy","isError":false}]},{"role":"assistant","sequence":6,"content":[{"type":"toolCall","name":"mcp__ai_sdk_harness_tools_quote_leg","arguments":{"leg":"monad-swap-mon-usdc","amount_in":"999970000000000000000"},"id":"toolu_01PCkXKbTz667gK21zxJnFZd"}]},{"role":"tool","sequence":7,"content":[{"type":"toolResult","text":"{\"quote_id\":\"q_1\",\"amount_out\":\"499885000\",\"cost_usd_micros\":105000,\"expires_at_ms\":300000}","toolCallId":"toolu_01PCkXKbTz667gK21zxJnFZd","toolName":"mcp__ai_sdk_harness_tools_quote_leg","isError":false}]},{"role":"assistant","sequence":8,"content":[{"type":"text","text":"Swap: 999.97 MON → 499.885000 USDC, cost $0.105. Now the bridge on that output."},{"type":"toolCall","name":"mcp__ai_sdk_harness_tools_quote_leg","arguments":{"leg":"monad-bridge-usdc-mainnet","amount_in":"499885000"},"id":"toolu_019HezfRdmB42tJFUEvucvT4"}]},{"role":"tool","sequence":9,"content":[{"type":"toolResult","text":"{\"quote_id\":\"q_2\",\"amount_out\":\"499385000\",\"cost_usd_micros\":505000,\"expires_at_ms\":300000}","toolCallId":"toolu_019HezfRdmB42tJFUEvucvT4","toolName":"mcp__ai_sdk_harness_tools_quote_leg","isError":false}]},{"role":"assistant","sequence":10,"content":[{"type":"toolCall","name":"mcp__ai_sdk_ha